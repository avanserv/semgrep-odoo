<odoo>
    <record id="view_partner_form" model="ir.ui.view">
        <field name="arch" type="xml">
            <form>
                <!-- ruleid: odoo-view-attrs-states-removed -->
                <field name="ref" attrs="{'invisible': [('is_company', '=', False)]}"/>
                <!-- ruleid: odoo-view-attrs-states-removed -->
                <button name="action_confirm" states="draft"/>
                <!-- ruleid: odoo-view-attrs-states-removed -->
                <page string="Sales" attrs="{'invisible': [('customer_rank', '=', 0)]}">
                    <field name="user_id"/>
                </page>
                <!-- ok: odoo-view-attrs-states-removed -->
                <field name="vat" invisible="not is_company"/>
            </form>
        </field>
    </record>
    <record id="view_partner_list" model="ir.ui.view">
        <field name="arch" type="xml">
            <!-- ruleid: odoo-view-tree-renamed -->
            <tree>
                <field name="name"/>
            </tree>
        </field>
    </record>
    <record id="action_partner" model="ir.actions.act_window">
        <!-- ruleid: odoo-view-tree-renamed -->
        <field name="view_mode">tree,form</field>
    </record>
    <record id="action_partner_list" model="ir.actions.act_window">
        <!-- ok: odoo-view-tree-renamed -->
        <field name="view_mode">list,form</field>
    </record>
</odoo>
